# Copiar a .env y completar valores reales

SPRING_PROFILES_ACTIVE=dev

# AWS (LocalStack en dev: S3 + DynamoDB)
AWS_REGION=us-east-1
AWS_ACCESS_KEY=mock-key
AWS_SECRET_KEY=mock-secret
AWS_BUCKET_NAME=lostres-dms-bucket
AWS_ENDPOINT_URL=http://localhost:4566
AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566
# En producción EC2 usar IAM roles:
AWS_USE_IAM=false

# DynamoDB
DYNAMODB_DOCUMENTS_TABLE=dms-documents
DYNAMODB_AUDIT_TABLE=dms-audit-logs

# Seguridad
SECURITY_ENABLED=false
ENFORCE_API_KEY=false
SERVICE_API_KEY=
REQUIRE_USER_ID=true
REQUIRE_METER_ID=false

# Upload
MAX_FILE_SIZE_BYTES=52428800

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=60

# Limpieza PENDING
PENDING_EXPIRATION_HOURS=24
